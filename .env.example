# Configuración SMTP Gmail
# 1. Activa "Verificación en dos pasos" en tu cuenta de Google
# 2. Genera una "Contraseña de aplicación" en https://myaccount.google.com/apppasswords
# 3. Copia la contraseña generada aquí

SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-contraseña-de-aplicacion-gmail

# Correo donde llegarán los mensajes de contacto
CONTACT_EMAIL=team@Nexxts.com.ec

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3000