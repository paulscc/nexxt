<!doctype html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Integraciones IA — Nexxts Quito Ecuador</title>
<link rel="icon" href="assets/logoo.png" type="image/png">
<meta name="description" content="Integraciones de inteligencia artificial en Nexxts. Automatización de procesos, chatbots, asistentes virtuales y soluciones IA para empresas.">
<style>
:root {
  --bg:      oklch(96.5% 0.015 75);
  --surface: oklch(98.5% 0.008 75);
  --fg:      oklch(18% 0.02 60);
  --muted:   oklch(48% 0.015 60);
  --border:  oklch(88% 0.012 75);
  --accent:  oklch(52% 0.12 28);
  --accent-soft: oklch(78% 0.06 28);
  --font-display: 'Iowan Old Style', 'Charter', Georgia, 'Times New Roman', serif;
  --font-body:    -apple-system, BlinkMacSystemFont, 'Segoe UI', system-ui, sans-serif;
  --font-mono:    ui-monospace, 'IBM Plex Mono', 'JetBrains Mono', Menlo, monospace;
  --max-width: 1280px;
  --gutter: clamp(1rem, 4vw, 3rem);
}
*, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
html { font-size: 100%; -webkit-font-smoothing: antialiased; }
body {
  font-family: var(--font-body); color: var(--fg); background: var(--bg);
  line-height: 1.6; overflow-x: hidden;
}
img, svg { max-width: 100%; display: block; }
a { color: var(--accent); text-decoration: none; }
a:hover { text-decoration: underline; }
h1, h2, h3, h4 { font-family: var(--font-display); font-weight: 400; line-height: 1.15; }
h1 { font-size: clamp(2.5rem, 6vw, 4.5rem); letter-spacing: -0.01em; }
h2 { font-size: clamp(1.8rem, 4vw, 3rem); }
h3 { font-size: clamp(1.3rem, 2.5vw, 1.75rem); }
h4 { font-size: clamp(1rem, 1.5vw, 1.2rem); }
.ds-serif { font-family: var(--font-body); }
.em-serif { font-family: var(--font-display); font-style: italic; }
.mono { font-family: var(--font-mono); font-size: 0.85em; text-transform: uppercase; letter-spacing: 0.08em; }
.accent { color: var(--accent); }
.container { max-width: var(--max-width); margin: 0 auto; padding: 0 var(--gutter); }
.section { padding: clamp(4rem, 8vw, 8rem) 0; position: relative; }
.section-label {
  font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase;
  letter-spacing: 0.12em; color: var(--muted); margin-bottom: 1rem;
}
.topbar {
  width: 100%;
  background: var(--surface);
  border-bottom: 1px solid var(--border);
}
.topbar-inner {
  display: flex; justify-content: space-between; align-items: center;
  padding: 0.6rem var(--gutter); font-size: 0.7rem;
  font-family: var(--font-mono); text-transform: uppercase; letter-spacing: 0.1em;
  color: var(--muted); background: var(--surface);
  border-bottom: 1px solid var(--border);
  max-width: var(--max-width); margin: 0 auto;
}
.topbar-brand { font-weight: 600; color: var(--fg); }
nav {
  position: sticky; top: 0; z-index: 100;
  background: rgba(255 255 255 / 0.85);
  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border); transition: transform 0.3s;
}
nav.nav-hidden { transform: translateY(-100%); }
.nav-inner {
  max-width: var(--max-width); margin: 0 auto;
  display: flex; justify-content: space-between; align-items: center;
  padding: 0.8rem var(--gutter);
}
.nav-logo {
  font-family: var(--font-display); font-size: 1.25rem; font-weight: 600;
  color: var(--fg); text-decoration: none;
  display: flex; align-items: center; gap: 0.4rem;
}
.nav-logo:hover { text-decoration: none; }
.nav-logo-mark { color: var(--accent); font-size: 1.5rem; }
.nav-links { display: flex; gap: 1.5rem; list-style: none; font-size: 0.85rem; }
.nav-links a { color: var(--muted); transition: color 0.2s; display: flex; align-items: center; gap: 0.3rem; }
.nav-links a:hover { color: var(--fg); text-decoration: none; }
.nav-badge {
  font-family: var(--font-mono); font-size: 0.6rem;
  background: var(--accent-soft); color: var(--accent);
  padding: 0.1rem 0.4rem; border-radius: 3px;
}
.hero {
  min-height: calc(100vh - 120px);
  display: flex; flex-direction: column; justify-content: center;
  padding: 4rem 0; position: relative;
}
.hero-grid {
  display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;
}
.hero-label {
  font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase;
  letter-spacing: 0.15em; color: var(--accent); margin-bottom: 1.5rem;
}
.hero h1 { margin-bottom: 1.5rem; }
.hero h1 .em-serif { color: var(--accent); }
.hero-lead {
  font-size: clamp(1.1rem, 1.5vw, 1.3rem); color: var(--muted);
  line-height: 1.7; margin-bottom: 2.5rem; max-width: 32em;
}
.hero-actions { display: flex; gap: 1rem; flex-wrap: wrap; margin-bottom: 3rem; }
.btn {
  display: inline-flex; align-items: center; gap: 0.5rem;
  padding: 0.85rem 2rem; font-family: var(--font-body);
  font-size: 0.95rem; font-weight: 500; border: none;
  cursor: pointer; transition: all 0.2s; text-decoration: none;
}
.btn:hover { text-decoration: none; }
.btn-primary { background: var(--accent); color: #fff; border-radius: 2px; }
.btn-primary:hover { background: oklch(44% 0.12 28); transform: translateY(-1px); }
.btn-secondary { background: transparent; color: var(--fg); border: 1px solid var(--border); border-radius: 2px; }
.btn-secondary:hover { border-color: var(--muted); background: var(--surface); }
.hero-stats {
  display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.5rem;
  padding-top: 2rem; border-top: 1px solid var(--border);
}
.stat-value { font-family: var(--font-display); font-size: clamp(1.5rem, 2.5vw, 2.2rem); color: var(--fg); }
.stat-label { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
.hero-image { aspect-ratio: 4/5; background: var(--border); overflow: hidden; position: relative; }
.hero-image img { width: 100%; height: 100%; object-fit: cover; }
.section-dark { background: oklch(15% 0.015 60); color: oklch(92% 0.005 80); }
.section-dark .section-label { color: oklch(60% 0.015 60); }
.section-dark .btn-secondary { border-color: oklch(35% 0.01 60); color: oklch(90% 0.005 80); }
.section-dark .btn-secondary:hover { border-color: oklch(60% 0.01 60); }
.section-alt { background: var(--surface); }
.cards-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; margin-top: 2rem; }
.card { background: var(--surface); border: 1px solid var(--border); padding: 2rem; transition: all 0.3s; }
.card:hover { transform: translateY(-2px); box-shadow: 0 4px 20px rgba(0,0,0,0.04); }
.card-num { font-family: var(--font-display); font-size: 2.5rem; color: var(--accent); opacity: 0.3; line-height: 1; margin-bottom: 0.5rem; }
.card-tag { font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 0.75rem; }
.card h3 { margin-bottom: 0.75rem; }
.card p { font-size: 0.95rem; color: var(--muted); line-height: 1.6; }
.tech-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 1.5rem; margin-top: 2rem; }
.tech-item { background: var(--surface); border: 1px solid var(--border); padding: 1.5rem; text-align: center; transition: all 0.3s; }
.tech-item:hover { transform: translateY(-2px); }
.tech-icon { font-size: 2rem; margin-bottom: 0.75rem; }
.tech-item h4 { font-size: 0.9rem; margin-bottom: 0.25rem; }
.tech-item p { font-size: 0.75rem; color: var(--muted); font-family: var(--font-mono); }
.process-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 2rem; margin-top: 2rem; }
.process-step { position: relative; padding-top: 2.5rem; }
.process-step::before { content: attr(data-num); position: absolute; top: 0; left: 0; font-family: var(--font-display); font-size: 3rem; color: var(--accent); opacity: 0.15; line-height: 1; }
.process-tag { font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); margin-bottom: 0.5rem; }
.process-step h3 { margin-bottom: 0.5rem; }
.process-step p { font-size: 0.9rem; color: var(--muted); line-height: 1.6; }
.work-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 2rem; margin-top: 2rem; }
.work-card { background: oklch(20% 0.015 60); padding: 2.5rem; transform: rotate(-0.5deg); transition: all 0.4s; position: relative; }
.work-card:nth-child(2) { transform: rotate(0.5deg) translateY(1rem); }
.work-card:hover { transform: rotate(0deg) translateY(-0.25rem); }
.work-card-category { font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: oklch(60% 0.04 30); margin-bottom: 0.75rem; }
.work-card h3 { font-size: 1.5rem; color: oklch(92% 0.005 80); margin-bottom: 0.5rem; }
.work-card p { font-size: 0.9rem; color: oklch(70% 0.01 70); }
.testimonial { text-align: center; max-width: 720px; margin: 0 auto; padding: 3rem 0; }
.testimonial-quote { font-family: var(--font-display); font-size: clamp(1.2rem, 2vw, 1.6rem); line-height: 1.6; font-style: italic; margin-bottom: 1.5rem; position: relative; }
.testimonial-quote::before { content: '\201C'; font-size: 4rem; color: var(--accent); opacity: 0.2; position: absolute; top: -1.5rem; left: -1rem; font-family: var(--font-display); line-height: 1; }
.testimonial-author { font-family: var(--font-mono); font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--muted); }
.cta-ribbon { background: var(--accent); color: #fff; padding: 4rem 0; text-align: center; position: relative; }
.cta-ribbon::before { content: ''; position: absolute; top: 0; left: 0; right: 0; height: 4px; background: oklch(44% 0.12 28); }
.cta-ribbon h2 { color: #fff; }
.cta-ribbon p { font-size: 1.05rem; opacity: 0.85; margin-bottom: 2rem; max-width: 32em; margin-left: auto; margin-right: auto; }
.cta-form { display: flex; gap: 0.5rem; justify-content: center; flex-wrap: wrap; }
.cta-form input { padding: 0.85rem 1.2rem; border: 1px solid rgba(255,255,255,0.3); background: rgba(255,255,255,0.1); color: #fff; font-size: 0.95rem; min-width: 280px; font-family: var(--font-body); }
.cta-form input::placeholder { color: rgba(255,255,255,0.5); }
.cta-form input:focus { outline: none; border-color: #fff; }
.cta-form .btn { background: #fff; color: var(--accent); border-radius: 2px; }
.cta-form .btn:hover { background: oklch(95% 0.01 80); }
footer { background: var(--fg); color: oklch(88% 0.005 80); padding: 4rem 0 2rem; }
.footer-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; margin-bottom: 3rem; }
.footer-col h4 { font-family: var(--font-mono); font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.1em; color: oklch(60% 0.01 60); margin-bottom: 1rem; }
.footer-col ul { list-style: none; }
.footer-col li { margin-bottom: 0.5rem; }
.footer-col a { color: oklch(80% 0.005 80); font-size: 0.9rem; }
.footer-col a:hover { color: #fff; }
.footer-mega { font-family: var(--font-display); font-size: clamp(2rem, 5vw, 3.5rem); color: oklch(92% 0.005 80); line-height: 1.1; border-top: 1px solid oklch(30% 0.01 60); padding-top: 2rem; margin-top: 2rem; }
.footer-mega .em-serif { color: var(--accent); font-style: italic; }
.footer-bottom { font-family: var(--font-mono); font-size: 0.65rem; text-transform: uppercase; letter-spacing: 0.1em; color: oklch(45% 0.01 60); border-top: 1px solid oklch(25% 0.01 60); padding-top: 1.5rem; margin-top: 1.5rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem; }
[data-reveal] { opacity: 0; transform: translateY(20px); transition: opacity 0.6s ease, transform 0.6s ease; }
[data-reveal].revealed { opacity: 1; transform: translateY(0); }
[data-reveal][data-delay="100"] { transition-delay: 0.1s; }
[data-reveal][data-delay="200"] { transition-delay: 0.2s; }
[data-reveal][data-delay="300"] { transition-delay: 0.3s; }
[data-reveal][data-delay="400"] { transition-delay: 0.4s; }
[data-reveal][data-delay="500"] { transition-delay: 0.5s; }
[data-reveal][data-delay="600"] { transition-delay: 0.6s; }
@media (prefers-reduced-motion: reduce) { [data-reveal] { opacity: 1; transform: none; transition: none; } .work-card, .card { transform: none !important; } }
@media (max-width: 1080px) { .hero-grid { grid-template-columns: 1fr; gap: 2rem; } .hero-image { aspect-ratio: 16/9; max-height: 60vh; } .work-grid { grid-template-columns: 1fr; } .work-card:nth-child(2) { transform: rotate(0deg) translateY(0); } }
@media (max-width: 880px) { .footer-grid { grid-template-columns: repeat(2, 1fr); } .nav-links { display: none; } }
@media (max-width: 560px) { .hero-stats { grid-template-columns: 1fr; gap: 1rem; } .cards-grid, .tech-grid, .process-grid { grid-template-columns: 1fr; } .footer-grid { grid-template-columns: 1fr; } .cta-form input { min-width: 100%; } }
.ruler-dotted { border: none; border-top: 1px dotted var(--border); margin: 2rem 0; }
.paper-texture { position: relative; }
.paper-texture::before { content: ''; position: absolute; inset: 0; background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='0.03'/%3E%3C/svg%3E"); background-size: 256px 256px; pointer-events: none; }
</style>
</head>
<body>

<div class="topbar">
  <div class="topbar-inner">
  <span class="topbar-brand">✦ Nexxts</span>
  <span>Quito, Ecuador — <span class="mono">2026</span></span>
  <span><span class="mono">Nexxts.es</span></span>
</div>

<nav id="main-nav">
  <div class="nav-inner">
    <a href="index.html" class="nav-logo">
      <span class="nav-logo-mark">✦</span>
      <span>Nexxts</span>
    </a>
    <ul class="nav-links">
      <li><a href="index.html">Inicio</a></li>
      <li><a href="nosotros.html">Nosotros <span class="nav-badge">Equipo</span></a></li>
      <li><a href="contacto.html">Contacto <span class="nav-badge">Habla con nosotros</span></a></li>
    </ul>
  </div>
</nav>

<section class="hero container" id="hero" data-reveal>
  <div class="hero-grid">
    <div>
      <div class="hero-label" data-reveal data-delay="100">Integraciones IA</div>
      <h1 data-reveal data-delay="200">
        Inteligencia artificial <span class="em-serif">para tu negocio</span>
        <span class="accent" style="font-family:var(--font-display)">✦</span>
      </h1>
      <p class="hero-lead" data-reveal data-delay="300">
        Integramos soluciones de inteligencia artificial para automatizar procesos, analizar datos, mejorar la toma de decisiones y crear experiencias personalizadas para tus clientes.
      </p>
      <div class="hero-actions" data-reveal data-delay="400">
        <a href="contacto.html" class="btn btn-primary">Iniciar Proyecto</a>
        <a href="#services" class="btn btn-secondary">Nuestras Soluciones</a>
      </div>
      <div class="hero-stats" data-reveal data-delay="500">
        <div class="stat">
          <div class="stat-value">50+</div>
          <div class="stat-label">Proyectos IA</div>
        </div>
        <div class="stat">
          <div class="stat-value">95%</div>
          <div class="stat-label">Precisión Promedio</div>
        </div>
        <div class="stat">
          <div class="stat-value">3x</div>
          <div class="stat-label">Eficiencia Operativa</div>
        </div>
      </div>
    </div>
    <div class="hero-image" data-reveal data-delay="300">
      <img src="assets/apis.gif" alt="Nexxts integraciones IA" loading="lazy">
    </div>
  </div>
</section>

<section class="section paper-texture" id="about" data-reveal>
  <div class="container">
    <div class="section-label" data-reveal data-delay="100">I. Visión General</div>
    <div class="hero-grid" style="grid-template-columns: 1fr 1fr; gap: 4rem;">
      <div>
        <h2 data-reveal data-delay="200">IA que <span class="em-serif">transforma</span></h2>
        <hr class="ruler-dotted" data-reveal data-delay="250">
      </div>
      <div>
        <p style="font-size:1.05rem;line-height:1.8;color:var(--muted)" data-reveal data-delay="300">
          En Nexxts integramos inteligencia artificial en los procesos de tu negocio para potenciar tus capacidades operativas. Ya sea automatizando tareas repetitivas, analizando grandes volúmenes de datos o creando asistentes virtuales inteligentes, nuestras soluciones de IA están diseñadas para generar resultados medibles y un retorno de inversión tangible.
        </p>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt paper-texture" id="services" data-reveal>
  <div class="container">
    <div class="section-label" data-reveal data-delay="100">II. Servicios IA</div>
    <h2 data-reveal data-delay="200">Lo que <span class="em-serif">integramos</span></h2>
    <div class="cards-grid">
      <div class="card" data-reveal data-delay="100">
        <div class="card-num">01</div>
        <div class="card-tag">Chatbots</div>
        <h3>Asistentes Virtuales Inteligentes</h3>
        <p>Implementamos chatbots con IA generativa para atención al cliente 24/7, capaces de comprender lenguaje natural, resolver consultas y derivar casos complejos a humanos.</p>
      </div>
      <div class="card" data-reveal data-delay="200">
        <div class="card-num">02</div>
        <div class="card-tag">APIs IA</div>
        <h3>Integración de APIs Inteligentes</h3>
        <p>Conectamos tu infraestructura con APIs de IA líderes (OpenAI, Anthropic, Google AI) para añadir capacidades cognitivas a tus aplicaciones existentes.</p>
      </div>
      <div class="card" data-reveal data-delay="300">
        <div class="card-num">03</div>
        <div class="card-tag">Automatización</div>
        <h3>Automatización de Procesos</h3>
        <p>Automatizamos flujos de trabajo con RPA inteligente y procesamiento de documentos, reduciendo costos operativos y errores humanos significativamente.</p>
      </div>
      <div class="card" data-reveal data-delay="400">
        <div class="card-num">04</div>
        <div class="card-tag">Análisis</div>
        <h3>Análisis Inteligente de Datos</h3>
        <p>Implementamos sistemas de análisis de datos impulsados por IA que descubren patrones, tendencias y oportunidades ocultas en tus datos empresariales.</p>
      </div>
      <div class="card" data-reveal data-delay="500">
        <div class="card-num">05</div>
        <div class="card-tag">Visión</div>
        <h3>Visión por Computadora</h3>
        <p>Integramos sistemas de visión artificial para reconocimiento de imágenes, detección de objetos, control de calidad visual y análisis de video en tiempo real.</p>
      </div>
      <div class="card" data-reveal data-delay="600">
        <div class="card-num">06</div>
        <div class="card-tag">NLP</div>
        <h3>Procesamiento de Lenguaje Natural</h3>
        <p>Soluciones NLP para análisis de sentimiento, clasificación de textos, extracción de información y comprensión del lenguaje natural en múltiples idiomas.</p>
      </div>
    </div>
  </div>
</section>

<section class="section paper-texture" id="tech" data-reveal>
  <div class="container">
    <div class="section-label" data-reveal data-delay="100">III. Tecnologías</div>
    <h2 data-reveal data-delay="200">Plataformas <span class="em-serif">IA</span></h2>
    <div class="tech-grid">
      <div class="tech-item" data-reveal data-delay="100"><div class="tech-icon">🤖</div><h4>OpenAI</h4><p>GPT-4 & APIs</p></div>
      <div class="tech-item" data-reveal data-delay="150"><div class="tech-icon">🟣</div><h4>Anthropic</h4><p>Claude API</p></div>
      <div class="tech-item" data-reveal data-delay="200"><div class="tech-icon">🔵</div><h4>Google AI</h4><p>Gemini & Vertex</p></div>
      <div class="tech-item" data-reveal data-delay="250"><div class="tech-icon">🟠</div><h4>Azure AI</h4><p>Microsoft Cognitive</p></div>
      <div class="tech-item" data-reveal data-delay="300"><div class="tech-icon">🐍</div><h4>LangChain</h4><p>Framework LLM</p></div>
      <div class="tech-item" data-reveal data-delay="350"><div class="tech-icon">🧠</div><h4>Hugging Face</h4><p>Modelos Open Source</p></div>
      <div class="tech-item" data-reveal data-delay="400"><div class="tech-icon">📸</div><h4>Computer Vision</h4><p>YOLO, OpenCV</p></div>
      <div class="tech-item" data-reveal data-delay="450"><div class="tech-icon">🗣️</div><h4>NLP</h4><p>spaCy, NLTK</p></div>
      <div class="tech-item" data-reveal data-delay="500"><div class="tech-icon">☁️</div><h4>AWS AI</h4><p>Bedrock & SageMaker</p></div>
      <div class="tech-item" data-reveal data-delay="550"><div class="tech-icon">⚡</div><h4>FastAPI</h4><p>APIs de IA</p></div>
      <div class="tech-item" data-reveal data-delay="600"><div class="tech-icon">📊</div><h4>Vector DBs</h4><p>Pinecone, Weaviate</p></div>
      <div class="tech-item" data-reveal data-delay="650"><div class="tech-icon">🔄</div><h4>RAG</h4><p>Recuperación Aumentada</p></div>
    </div>
  </div>
</section>

<section class="section section-alt paper-texture" id="process" data-reveal>
